{
  "run_name": "cv_final",
  "image_size": 224,
  "num_epochs": 90,
  "warmup_epochs": 5,
  "batch_size": 128,
  "num_workers": 12,
  "num_folds": 5,
  "val_fold": 0,
  "num_hidden": 4,
  "sizes": [64, 128, 256, 512],
  "blocks_per_stage": [2, 2, 2, 2],
  "stem_width": 64,
  "activation": "relu",
  "dropout": 0.2,
  "loss": "cross_entropy",
  "label_smoothing": 0.1,
  "opt": "adamw",
  "lr": 0.001,
  "weight_decay": 0.0005,
  "anneal": true,
  "amp": true,
  "ema": true,
  "ema_decay": 0.999,
  "eval_ema": true
}
